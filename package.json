{
  "name": "relay-mesh-network",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "RELAY — Decentralized disaster mesh communication platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n gateway,web -c yellow,cyan \"npm run dev:gateway\" \"npm run dev:web\"",
    "dev:web": "astro dev --host 0.0.0.0 --port 3000",
    "dev:gateway": "npm run dev --prefix gateway",
    "build": "npm run build:gateway && npm run build:web",
    "build:web": "astro build",
    "build:gateway": "npm run build --prefix gateway",
    "preview": "concurrently -n gateway,web -c yellow,cyan \"npm run start:gateway\" \"astro preview --host 0.0.0.0 --port 3000\"",
    "start:gateway": "npm run dev --prefix gateway",
    "install:all": "npm install && npm install --prefix gateway"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
